# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Provider dependency lock — not committed here (regenerated per-platform on init;
# avoids Windows-local vs Linux-CI hash mismatches)
.terraform.lock.hcl

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore plan output files (may contain sensitive values)
*.tfplan
tfplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Backend partial-config — holds the account-scoped state bucket name; keep it
# out of a public repo (use backend.hcl.example as the committed template).
backend.hcl

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage / type-checking caches
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/
.mypy_cache/
.dmypy.json
.ruff_cache/

# Jupyter / IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Package/tool managers
.python-version
Pipfile.lock
poetry.lock
__pypackages__/

# ---------------------------------------------------------------------------
# Secrets & credentials
# ---------------------------------------------------------------------------
# Environment / dotenv
.env
.env.*
!.env.example
!.env.sample

# Private keys & certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.asc

# SSH keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk

# Cloud / service-account credentials
credentials
credentials.json
.aws/
aws-credentials*
*-service-account*.json
gcp-*.json
.netrc
.npmrc
.pypirc

# HashiCorp Vault
.vault-token
.vault_password
*.vault

# Generic secret files
secrets.*
*.secret
*.secrets
.secrets/

# ---------------------------------------------------------------------------
# Git artifacts
# ---------------------------------------------------------------------------
*.orig          # merge-conflict leftovers
*.rej           # rejected patch hunks
*.patch
*.diff

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Claude Code (local overrides — keep shared config in claude-config/)
# ---------------------------------------------------------------------------
.claude/settings.local.json
